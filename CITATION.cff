title: "A Tiered Peer-Critique Architecture for AI Answers"
authors:
  - family-names: "Lott"
    given-names: "George W."
    orcid: "https://orcid.org/0009-0004-3401-7369"
version: "1.1"
date-released: 2026-09-05
doi: 10.5281/zenodo.22325883
url: "https://doi.org/10.5281/zenodo.22325883"
repository-code: "https://github.com/glott1993/peer-critique-panel"
